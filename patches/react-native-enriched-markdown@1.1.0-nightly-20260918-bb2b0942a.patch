+export const sameMediaSize = (a, b) => Math.abs(a - b) < 0.5;
+
+/** Accept only finite native frames with usable widths. */
+export const validMediaFrames = frames => frames.filter(({
+  x,
+  y,
+  width,
+  height
+}) => [x, y, width, height].every(Number.isFinite) && width > 0 && height >= 0);
+
+/** A width change requires React to measure again before native uses the height. */
+export const mediaOverrideForFrame = (id, frame, measurement) => frame && measurement && sameMediaSize(frame.width, measurement.width) ? measurement : {
+  id,
+  width: 0,
+  height: 1
+};
