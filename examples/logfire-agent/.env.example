# Keep real values in .env, which is ignored by Git.
LOGFIRE_TOKEN=
OPENAI_API_KEY=
# A model available to your account that supports Responses API function calls.
DEMO_MODEL=
# Copy the project URL from your own Logfire dashboard.
LOGFIRE_PROJECT_URL=https://logfire-us.pydantic.dev/YOUR_ORG/YOUR_PROJECT/
# Optional: use your project's region, or let Logfire infer it from its token.
# LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
# Optional: an authorized Responses-compatible model endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Show the synthetic question, answers, and tool arguments in Logfire.
# Leave false if adapting this example to private conversations.
DEMO_CAPTURE_CONTENT=true
