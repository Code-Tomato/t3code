+        @"id" : node.attributes[@"_enrmMediaSlot"],
+        @"x" : @(rect.origin.x),
+        @"y" : @(rect.origin.y),
+        @"width" : @(rect.size.width),
+        @"height" : @(rect.size.height)
+      }];
