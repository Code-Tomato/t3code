@@ -0,0 +1,7 @@
+#pragma once
+
+#import <Foundation/Foundation.h>
+
+// Rendering metadata only. Copy reconstruction retains the source semantics.
+static NSString *const ENRMRecognizedLinkAttributeName = @"ENRMRecognizedLink";
